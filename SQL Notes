A. Stored Procedure
CREATE PROCEDURE GetEmployees
AS
SELECT * FROM Employees;
B. Scalar Function
CREATE FUNCTION fn_GetSalary(@EmpId INT)
RETURNS INT AS
BEGIN
    RETURN (SELECT Salary FROM Employees WHERE EmpId = @EmpId);
END;
